{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/0.25.1/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": { "version": "Lua5.2", "requirePattern": ["?.lua", "?/init.lua"] },
  "strict": { "requirePath": true, "arrayIndex": true },
  "workspace": {
    "ignoreDir": ["node_modules", "dev", ".git", ".factorio-test"],
    "ignoreGlobs": [],
    "library": ["types"],
    "moduleMap": [
      { "pattern": "^__flib__\\.(.*)$", "replace": "$1" },
      { "pattern": "^__core__\\.lualib\\.(.*)$", "replace": "core.lualib.$1" }
    ]
  }
}
